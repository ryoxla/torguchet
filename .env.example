# ===== Настройки установки. Скопируйте этот файл в .env и впишите свои значения. =====
PORT=3000

# --- ВАРИАНТ 1: клиентская установка (одна компания, одна база) ---
MODE=single
DATABASE_URL=postgresql://postgres:ПАРОЛЬ@localhost:5432/torguchet

# --- ВАРИАНТ 2: несколько компаний (master-база). Для него удалите две строки выше и раскомментируйте: ---
# MASTER_DATABASE_URL=postgresql://postgres:ПАРОЛЬ@localhost:5432/trade_master

# Секрет для подписи входа создаётся автоматически (файл .auth_secret). Задавать не нужно.
# Не копируйте .auth_secret и .env между установками.
